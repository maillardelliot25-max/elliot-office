# Claude API (thin orchestration layer per the build spec's architecture section)
ANTHROPIC_API_KEY=

# SMTP delivery for the trend brief email. Leave unset to run in dry-run mode,
# where the rendered email is written to output/ instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=agent@example.com

# Per-run cost ceiling (USD). A run that would exceed this is aborted before
# delivery, per the architecture section's "LLM cost control" guidance.
TREND_BRIEF_COST_CEILING_USD=0.50
