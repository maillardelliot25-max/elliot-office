# Required. Postgres storage via Supabase (see README for the project this
# app's tables live in). Server-side only — never expose SUPABASE_ANON_KEY
# to the browser; nothing in this app does.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional. Intent classification and brief generation run on local
# heuristics/templates with no key set. Set this to upgrade both to real
# Claude calls.
ANTHROPIC_API_KEY=

# Optional. Leave unset to run agent deliveries in dry-run mode (the brief
# is generated and logged, but no email is actually sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=agent@example.com
