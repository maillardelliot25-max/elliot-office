# Optional. Intent classification and brief generation run on local
# heuristics/templates with no key set. Set this to upgrade both to real
# Claude calls.
ANTHROPIC_API_KEY=

# Optional. Leave unset to run agent deliveries in dry-run mode (written to
# ../output/*.eml instead of sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=agent@example.com
