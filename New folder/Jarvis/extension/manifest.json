{
  "manifest_version": 3,
  "name": "Jarvis Assist",
  "version": "1.0.0",
  "description": "Jarvis watches for forms, highlights them and fills them for you from your God Station.",
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" },
  "permissions": ["storage", "notifications"],
  "host_permissions": ["http://localhost:8780/*", "http://127.0.0.1:8780/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Jarvis Assist" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
