{
  "name": "friday-desktop",
  "productName": "Friday",
  "version": "2.1.0",
  "description": "Friday, Elliot's AI, as a Windows app. Keeps Friday and Jarvis running.",
  "author": "Maillard AI",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "ai.maillard.friday.desktop",
    "productName": "Friday",
    "artifactName": "Friday-Setup.exe",
    "directories": { "output": "dist" },
    "files": ["main.js", "loading.html", "assets/**"],
    "extraResources": [
      { "from": "../../app", "to": "LocalAI/app", "filter": ["**/*", "!data/**", "!**/__pycache__/**"] },
      { "from": "../../install-and-start.ps1", "to": "LocalAI/install-and-start.ps1" },
      { "from": "../../../Shared", "to": "Shared", "filter": ["**/*", "!**/__pycache__/**"] }
    ],
    "win": { "target": "nsis", "icon": "assets/icon.ico" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Friday",
      "runAfterFinish": true
    }
  }
}
