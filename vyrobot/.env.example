# Copy this file to .env and fill in your own values. Never commit the
# resulting .env file - it contains secrets.

# --- Global safety ----------------------------------------------------
VYROBOT_DRY_RUN=true
VYROBOT_LOG_LEVEL=INFO
VYROBOT_LOG_FILE=vyrobot.log

# --- Risk parameters (hardcoded safety ceilings still apply regardless) -
VYROBOT_MAX_ALLOCATION_PCT=0.05
VYROBOT_MIN_CONFIDENCE=0.75
VYROBOT_MAX_SPREAD_PCT=0.05
VYROBOT_KELLY_FRACTION=0.5
VYROBOT_MAX_OPEN_POSITIONS=10
VYROBOT_MIN_ORDER_NOTIONAL_USD=1.0
VYROBOT_MAX_DAILY_LOSS_PCT=0.15

# --- LLM scoring --------------------------------------------------------
# provider: "anthropic" or "openai"
VYROBOT_LLM_PROVIDER=anthropic
VYROBOT_LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VYROBOT_LLM_MODEL=claude-haiku-4-5-20251001
# VYROBOT_LLM_API_URL=https://api.anthropic.com/v1/messages

# --- News ingestion -------------------------------------------------
VYROBOT_NEWS_POLL_INTERVAL_SECONDS=60
VYROBOT_GDELT_ENABLED=true
VYROBOT_GDELT_QUERY=sourcelang:english
# Comma-separated list overrides the built-in default RSS feed list.
# VYROBOT_RSS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://apnews.com/apf-topnews?output=rss

# --- Polymarket (Polygon) ---------------------------------------------
VYROBOT_POLYMARKET_ENABLED=false
VYROBOT_POLYGON_RPC_URL=https://polygon-rpc.com
VYROBOT_POLYMARKET_PRIVATE_KEY=0xyourwalletprivatekey
VYROBOT_POLYMARKET_FUNDER_ADDRESS=0xyourpolymarketproxywallet
VYROBOT_POLYMARKET_API_KEY=
VYROBOT_POLYMARKET_API_SECRET=
VYROBOT_POLYMARKET_API_PASSPHRASE=
# Comma-separated CLOB token ids you want to bootstrap on startup.
VYROBOT_POLYMARKET_CONDITION_IDS=

# --- Kalshi --------------------------------------------------------
VYROBOT_KALSHI_ENABLED=false
VYROBOT_KALSHI_REST_URL=https://trading-api.kalshi.com/trade-api/v2
VYROBOT_KALSHI_WS_URL=wss://trading-api.kalshi.com/trade-api/ws/v2
VYROBOT_KALSHI_API_KEY_ID=
VYROBOT_KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
VYROBOT_KALSHI_TICKERS=
VYROBOT_USD_TO_USDT_RATE=1.0

# --- Watched markets file ----------------------------------------------
VYROBOT_MARKETS_FILE=./markets.json
